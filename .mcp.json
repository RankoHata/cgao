{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      }
    },
    "cgao": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bridge/mcp-server.cjs"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_PAT}",
        "CGAO_STATE_DIR": "${CLAUDE_PLUGIN_ROOT}/.cgao"
      }
    }
  }
}
